rules_version = '2';

// Signed-in players (Google) own users/{uid}. Entitlements and devAccounts are written
// only from the console. balanceLogs are anonymous append-only game summaries that only
// the developer role can read.
// Deploy: Firebase console > Firestore Database > Rules > paste > Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null; }
    // Short display strings (nicknames, codes) so no one can store or show oversized text.
    function shortStr(v, n){ return v is string && v.size() <= n; }
    function verifiedEmail(){
      return signedIn() && request.auth.token.email_verified == true;
    }
    function devRole(){
      return verifiedEmail()
        && exists(/databases/$(database)/documents/devAccounts/$(request.auth.token.email))
        && get(/databases/$(database)/documents/devAccounts/$(request.auth.token.email)).data.role == 'dev';
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || devRole());
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }
    // Nicknames are unique: the first account to claim one keeps it for good.
    match /nicknames/{key} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','nick','at','history'])
        && (!('history' in request.resource.data) || (request.resource.data.history is list && request.resource.data.history.size() <= 10))
        && key.size() >= 1 && key.size() <= 32;
      // The owner can release their old name when changing it.
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow list, update: if false;
    }
    match /entitlements/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
    match /devAccounts/{email} {
      allow get: if verifiedEmail() && request.auth.token.email == email;
      allow list, write: if false;
    }
    match /balanceLogs/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['players','mode','aiDifficulty','firstSeat','winnerSeat','winnerOrder','turns','jokers','bombs','autoResets','straight','at'])
        && request.resource.data.players is int
        && request.resource.data.players >= 2 && request.resource.data.players <= 4
        && request.resource.data.mode in ['solo', 'online'];
      allow read: if devRole();
      allow update, delete: if false;
    }

    // Daily challenge: one score doc per player per day. Starting writes a "failed"
    // placeholder; finishing may fill in the turn count once.
    // day must be today in KST by the server clock (10 minutes of slack either way for a
    // client clock near midnight), so results can't be filed under other dates.
    function isKstDay(day, t){
      return int(day.split('-')[0]) == t.year() && int(day.split('-')[1]) == t.month() && int(day.split('-')[2]) == t.day();
    }
    function isKstToday(day){
      return isKstDay(day, request.time + duration.value(9, 'h'))
        || isKstDay(day, request.time + duration.value(9, 'h') - duration.value(10, 'm'))
        || isKstDay(day, request.time + duration.value(9, 'h') + duration.value(10, 'm'));
    }
    match /daily/{day}/scores/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid && notBanned()
        && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && isKstToday(day)
        && request.resource.data.keys().hasOnly(['name','avatar','failed','at'])
        && shortStr(request.resource.data.name, 32) && shortStr(request.resource.data.avatar, 32)
        && request.resource.data.failed == true;
      allow update: if signedIn() && request.auth.uid == uid
        && resource.data.failed == true
        && request.resource.data.keys().hasOnly(['name','avatar','failed','at','turns','ms'])
        && request.resource.data.failed == false
        && request.resource.data.turns is int
        // A straight takes 5 banked cards and a turn banks at most one; a turn takes time.
        && request.resource.data.turns >= 5 && request.resource.data.turns <= 200
        && request.resource.data.ms is int
        && request.resource.data.ms >= request.resource.data.turns * 300 && request.resource.data.ms <= 86400000
        && request.resource.data.at == resource.data.at
        && request.resource.data.ms <= request.time.toMillis() - resource.data.at.toMillis() + 5000;
      allow delete: if false;
    }
    // A season write must carry a finished daily result (lastDay) from that month, once per
    // day, and its best can only become that day's turns/time when it is actually better.
    function notBanned(){
      return !exists(/databases/$(database)/documents/bans/$(request.auth.uid))
        || get(/databases/$(database)/documents/bans/$(request.auth.uid)).data.until < request.time;
    }
    function dailyResult(day, uid){
      return get(/databases/$(database)/documents/daily/$(day)/scores/$(uid)).data;
    }
    function fillsMissingTime(uid){
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bestMs','updatedAt'])
        && resource.data.get('bestMs', 0) == 0
        && dailyResult(resource.data.lastDay, uid).turns == resource.data.bestTurns
        && request.resource.data.bestMs == dailyResult(resource.data.lastDay, uid).get('ms', 0);
    }
    function nextDayResult(season, uid){
      let n = request.resource.data;
      let old = resource.data;
      let r = dailyResult(n.lastDay, uid);
      return n.lastDay is string
        && n.lastDay.matches('^' + season + '-[0-9]{2}$')
        && n.lastDay > old.get('lastDay', '')
        && n.days == old.get('days', 0) + 1
        && r.failed == false
        && ((n.bestTurns == old.get('bestTurns', -1) && n.bestMs == old.get('bestMs', 0))
          || (n.bestTurns == r.turns && n.bestMs == r.get('ms', 0)
              && (n.bestTurns < old.get('bestTurns', 200)
                || (n.bestTurns == old.get('bestTurns', 200)
                  && (old.get('bestMs', 0) == 0 || n.bestMs < old.get('bestMs', 0))))));
    }
    match /seasons/{season}/players/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid
        && season.matches('^[0-9]{4}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['name','avatar','bestTurns','bestMs','days','lastDay','updatedAt'])
        && request.resource.data.lastDay is string
        && request.resource.data.lastDay.matches('^' + season + '-[0-9]{2}$')
        && dailyResult(request.resource.data.lastDay, uid).failed == false
        && request.resource.data.bestTurns == dailyResult(request.resource.data.lastDay, uid).turns
        && request.resource.data.bestMs == dailyResult(request.resource.data.lastDay, uid).get('ms', 0)
        && request.resource.data.days == 1;
      // A next-day result, or (once) filling in the time a record made before times existed lacked.
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','avatar','bestTurns','bestMs','days','lastDay','updatedAt'])
        && (fillsMissingTime(uid) || nextDayResult(season, uid));
      allow delete: if false;
    }

    // Coin wallet. One action per write, each recomputed here: attendance (KST day from the
    // server clock), buying one paid item at its fixed price, buying 30 days of membership,
    // or a developer grant (season rewards). Prices match COIN_PRICES in index.html.
    function kstToday(){ return math.floor((request.time.toMillis() + 32400000) / 86400000); }
    function paidItems(){
      return ['pattern:onyx','pattern:stained','pattern:harlequin','pattern:neon','pattern:aurora',
              'pattern:tiger','pattern:bone','pattern:bamboo',
              'theme:neon','theme:ocean','theme:felt',
              'border:owlmoon','border:dragon','border:foxfire','border:bolt','border:wind','border:stars',
              'avatar:tiger','avatar:hawk'];
    }
    function itemPrice(key){ return key.split(':')[0] == 'theme' ? 330 : 220; }
    function walletShape(n){
      return n.keys().hasOnly(['coins','items','membershipUntil','attendDay','streak','lastBuy'])
        && n.keys().hasAll(['coins','items','membershipUntil','attendDay','streak'])
        && n.coins is int && n.coins >= 0 && n.items is list
        && n.membershipUntil is int && n.attendDay is int && n.streak is int;
    }
    function sameExcept(n, o, fields){
      return n.diff(o).affectedKeys().hasOnly(fields);
    }
    function isAttend(n, o){
      return sameExcept(n, o, ['coins','attendDay','streak'])
        && n.attendDay == kstToday() && o.attendDay < kstToday()
        && ((o.attendDay == kstToday() - 1 && n.streak == o.streak + 1) || (o.attendDay < kstToday() - 1 && n.streak == 1))
        && ((n.streak % 7 == 0 && n.coins == o.coins + 7) || (n.streak % 7 != 0 && n.coins == o.coins + 2));
    }
    function isBuy(n, o){
      return sameExcept(n, o, ['coins','items','lastBuy'])
        && n.lastBuy in paidItems() && !(n.lastBuy in o.items)
        && n.items == o.items.concat([n.lastBuy])
        && n.coins == o.coins - itemPrice(n.lastBuy);
    }
    function isMembership(n, o){
      return sameExcept(n, o, ['coins','membershipUntil'])
        && n.coins == o.coins - 330
        && ((o.membershipUntil > request.time.toMillis() && n.membershipUntil == o.membershipUntil + 2592000000)
          || (o.membershipUntil <= request.time.toMillis()
            && n.membershipUntil >= request.time.toMillis() + 2592000000 - 600000
            && n.membershipUntil <= request.time.toMillis() + 2592000000 + 600000));
    }
    // 닉네임 변경: 490 coins, stamped with a fresh lastBuy ("nick:<time>").
    function isNickChange(n, o){
      return sameExcept(n, o, ['coins','lastBuy'])
        && n.lastBuy is string && n.lastBuy.matches('^nick:[0-9]+$')
        && n.lastBuy != o.get('lastBuy', '')
        && n.coins == o.coins - 490;
    }
    // Event coins: claimed once together with users/{uid}/mail/{cid}, exactly the event's amount.
    function isMailCoins(n, o, uid){
      return sameExcept(n, o, ['coins','lastBuy'])
        && n.lastBuy is string && n.lastBuy.matches('^mail:[A-Za-z0-9]+$')
        && get(/databases/$(database)/documents/campaigns/$(n.lastBuy.split(':')[1])).data.rewardKind == 'coins'
        && !exists(/databases/$(database)/documents/users/$(uid)/mail/$(n.lastBuy.split(':')[1]))
        && existsAfter(/databases/$(database)/documents/users/$(uid)/mail/$(n.lastBuy.split(':')[1]))
        && n.coins == o.coins + get(/databases/$(database)/documents/campaigns/$(n.lastBuy.split(':')[1])).data.rewardCoins;
    }
    // Event membership: 30 days added once, together with the mail receipt.
    function isMailMembership(n, o, uid){
      return sameExcept(n, o, ['membershipUntil','lastBuy'])
        && n.lastBuy is string && n.lastBuy.matches('^mail:[A-Za-z0-9]+$')
        && get(/databases/$(database)/documents/campaigns/$(n.lastBuy.split(':')[1])).data.rewardKind == 'membership'
        && !exists(/databases/$(database)/documents/users/$(uid)/mail/$(n.lastBuy.split(':')[1]))
        && existsAfter(/databases/$(database)/documents/users/$(uid)/mail/$(n.lastBuy.split(':')[1]))
        && ((o.membershipUntil > request.time.toMillis() && n.membershipUntil == o.membershipUntil + 2592000000)
          || (o.membershipUntil <= request.time.toMillis()
            && n.membershipUntil >= request.time.toMillis() + 2592000000 - 600000
            && n.membershipUntil <= request.time.toMillis() + 2592000000 + 600000));
    }
    // Recall by the developer role: coins only down, bought items only removed, membership only shorter.
    function isRecall(n, o){
      return devRole() && sameExcept(n, o, ['coins','items','membershipUntil'])
        && n.coins <= o.coins && o.items.hasAll(n.items) && n.membershipUntil <= o.membershipUntil;
    }
    function isGrant(n, o){
      return devRole() && sameExcept(n, o, ['coins']) && n.coins > o.coins && n.coins <= o.coins + 100;
    }
    match /wallets/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || devRole());
      allow create: if walletShape(request.resource.data) && (
        (signedIn() && request.auth.uid == uid
          && request.resource.data.coins == 2 && request.resource.data.streak == 1
          && request.resource.data.attendDay == kstToday()
          && request.resource.data.items.size() == 0 && request.resource.data.membershipUntil == 0
          && !('lastBuy' in request.resource.data))
        || (devRole()
          && request.resource.data.coins >= 1 && request.resource.data.coins <= 100
          && request.resource.data.streak == 0 && request.resource.data.attendDay == 0
          && request.resource.data.items.size() == 0 && request.resource.data.membershipUntil == 0
          && !('lastBuy' in request.resource.data)));
      allow update: if walletShape(request.resource.data) && (
        (signedIn() && request.auth.uid == uid && (
          isAttend(request.resource.data, resource.data)
          || isBuy(request.resource.data, resource.data)
          || isMembership(request.resource.data, resource.data)
          || isNickChange(request.resource.data, resource.data)
          || isMailCoins(request.resource.data, resource.data, uid)
          || isMailMembership(request.resource.data, resource.data, uid)))
        || isGrant(request.resource.data, resource.data)
        || isRecall(request.resource.data, resource.data));
      allow delete: if false;
    }
    // Ledger for the developer-run season payout: one doc per season, written once.
    match /seasonRewards/{season} {
      allow read: if signedIn();
      allow create: if devRole() && season.matches('^[0-9]{4}-[0-9]{2}$');
      allow update, delete: if false;
    }

    // Friends: presence is public to signed-in players; requests and friend lists only to the two.
    match /presence/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nick','avatar','online','at'])
        && shortStr(request.resource.data.nick, 32) && shortStr(request.resource.data.avatar, 32);
    }
    match /friendRequests/{id} {
      allow read: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if signedIn() && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string && request.resource.data.to != request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.to
        && request.resource.data.keys().hasOnly(['from','to','fromNick','at'])
        && shortStr(request.resource.data.fromNick, 32);
      allow delete: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }
    // Both entries are written by whoever accepts a pending request.
    match /users/{uid}/friends/{fid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['nick','at'])
        && ((request.auth.uid == uid && exists(/databases/$(database)/documents/friendRequests/$(fid + '_' + uid)))
          || (request.auth.uid == fid && exists(/databases/$(database)/documents/friendRequests/$(uid + '_' + fid))));
      allow delete: if signedIn() && (request.auth.uid == uid || request.auth.uid == fid);
    }
    // A room invite can only come from someone on the invitee's friend list.
    match /invites/{id} {
      allow read: if signedIn() && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow create, update: if signedIn() && request.resource.data.from == request.auth.uid
        && id == request.resource.data.to + '_' + request.auth.uid
        && exists(/databases/$(database)/documents/users/$(request.resource.data.to)/friends/$(request.auth.uid))
        && request.resource.data.keys().hasOnly(['from','to','fromNick','room','at'])
        && shortStr(request.resource.data.fromNick, 32) && shortStr(request.resource.data.room, 8);
      allow delete: if signedIn() && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
    }
    // Event mail: signing in during [start, end] records an entry; the reward can be claimed
    // until claimUntil. Only the developer role creates events.
    match /campaigns/{cid} {
      allow read: if signedIn();
      allow write: if devRole();
      match /entries/{uid} {
        allow get: if signedIn() && (request.auth.uid == uid || devRole());
        allow list: if devRole();
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['at'])
          && request.time >= get(/databases/$(database)/documents/campaigns/$(cid)).data.start
          && request.time <= get(/databases/$(database)/documents/campaigns/$(cid)).data.end
          && (!('targets' in get(/databases/$(database)/documents/campaigns/$(cid)).data)
            || request.auth.uid in get(/databases/$(database)/documents/campaigns/$(cid)).data.targets);
      }
    }
    match /users/{uid}/mail/{cid} {
      allow read: if signedIn() && (request.auth.uid == uid || devRole());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['reward','at'])
        && exists(/databases/$(database)/documents/campaigns/$(cid)/entries/$(uid))
        && request.time <= get(/databases/$(database)/documents/campaigns/$(cid)).data.claimUntil
        && request.resource.data.reward == get(/databases/$(database)/documents/campaigns/$(cid)).data.rewardId;
    }
    // Bans: set by the developer role; a player can read their own to see why.
    match /bans/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || devRole());
      allow write: if devRole();
    }
    // Main-screen notice (config/notice): everyone reads, the developer role writes.
    match /config/{id} {
      allow read: if signedIn();
      allow write: if devRole();
    }
    // Player reports: anyone signed in files one about someone else; the developer role reads and clears.
    match /reports/{id} {
      allow create: if signedIn() && request.resource.data.from == request.auth.uid
        && request.resource.data.target is string && request.resource.data.target != request.auth.uid
        && request.resource.data.keys().hasOnly(['from','fromNick','target','targetNick','reason','memo','room','at'])
        && request.resource.data.memo is string && request.resource.data.memo.size() <= 100
        && shortStr(request.resource.data.reason, 30) && shortStr(request.resource.data.fromNick, 32)
        && shortStr(request.resource.data.targetNick, 32) && shortStr(request.resource.data.room, 8);
      allow read, delete: if devRole();
      // Handled by the developer role: the report stays with its result.
      allow update: if devRole() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','result','doneAt']);
    }
    // Sanction history (warnings, bans, cleared reports): developer role only.
    match /sanctions/{id} {
      allow read, write: if devRole();
    }
    // A player's own anomaly self-check; read by the developer role.
    match /suspicious/{uid} {
      allow create, update, delete: if signedIn() && request.auth.uid == uid
        && (request.method == 'delete' || (request.resource.data.keys().hasOnly(['nick','flags','at'])
          && shortStr(request.resource.data.nick, 32) && request.resource.data.flags is list && request.resource.data.flags.size() <= 10));
      allow read: if devRole();
    }
    // Errors on players' screens (a few per session), read and cleared by the developer role.
    match /errorLogs/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['msg','src','line','screen','ua','uid','nick','at'])
        && request.resource.data.msg is string && request.resource.data.msg.size() <= 300
        && request.resource.data.ua is string && request.resource.data.ua.size() <= 160
        && shortStr(request.resource.data.src, 200) && shortStr(request.resource.data.screen, 40) && shortStr(request.resource.data.nick, 32);
      allow read, delete: if devRole();
      allow update: if false;
    }
    match /rooms/{code} {
      allow get: if signedIn() && code.matches('^[A-HJ-NP-Z2-9]{5}$');
      // Quick match lists open public lobbies only; private rooms stay unlistable.
      allow list: if signedIn() && resource.data.public == true && resource.data.phase == 'lobby';
      // uids: accounts that joined. Only they may change the room; anyone else may only
      // add themselves (joining). Rooms from before uids existed stay open as before.
      allow create: if signedIn() && code.matches('^[A-HJ-NP-Z2-9]{5}$')
        && request.resource.data.phase == 'lobby'
        && request.resource.data.players is list
        && request.resource.data.players.size() <= 4
        && (!('uids' in request.resource.data) || request.resource.data.uids == [request.auth.uid]);
      allow update: if signedIn()
        && request.resource.data.players is list
        && request.resource.data.players.size() <= 4
        && request.resource.data.phase in ['lobby', 'playing']
        && (!('uids' in resource.data)
          || (request.auth.uid in resource.data.uids && request.resource.data.get('uids', null) == resource.data.uids)
          || request.resource.data.get('uids', null) == resource.data.uids.concat([request.auth.uid]));
      allow delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
